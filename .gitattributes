# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source files
*.rs text eol=lf
*.tsx text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
